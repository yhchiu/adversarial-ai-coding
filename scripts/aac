#!/bin/sh
set -eu

AAC_PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# Presentation only: the Python package never reads LANG/LC_*. When the
# caller has not set AAC_LANG, map known OS tags to a shipped catalog.
if [ -z "${AAC_LANG:-}" ]; then
  loc=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
  case $loc in
    zh_TW*|zh-TW*|zh_HK*|zh-HK*|zh_Hant*|zh-Hant*)
      AAC_LANG=zh-TW
      ;;
    zh_CN*|zh-CN*|zh_SG*|zh-SG*|zh_Hans*|zh-Hans*)
      AAC_LANG=zh-CN
      ;;
    ja*)
      AAC_LANG=ja-JP
      ;;
    ko*)
      AAC_LANG=ko-KR
      ;;
    pt*)
      AAC_LANG=pt-BR
      ;;
  esac
  if [ -n "${AAC_LANG:-}" ]; then
    export AAC_LANG
  fi
fi

# The locked uv environment is the only Python this launcher should see.
# Machine-wide PYTHONHOME/PYTHONPATH crash CPython before our code runs.
unset PYTHONHOME PYTHONPATH

exec uv run \
  --project "$AAC_PROJECT_ROOT" \
  --locked \
  adversarial-ai-coding "$@"
